{
  "name": "stock-market-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "test:watch": "tsx --test --watch",
    "test:coverage": "tsx --test --experimental-test-coverage",
    "comments:strip": "node scripts/remove-code-comments.mjs",
    "comments:check": "node scripts/remove-code-comments.mjs --check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "backfill": "tsx scripts/backfill-historical.ts",
    "market:bootstrap": "bash scripts/bootstrap-market-data.sh",
    "deploy:rocket": "bash scripts/deploy-to-rocket.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "adm-zip": "^0.6.0",
    "axios": "1.18.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.25",
    "jsonwebtoken": "^9.0.2",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^0.555.0",
    "next": "16.2.12",
    "pg": "^8.20.0",
    "react": "19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "yahoo-finance2": "^3.13.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
